{
  "name": "@passmower/oidc-key-manager",
  "version": "1.2.2",
  "description": "CLI to manage secret keys required by oidc-gateway",
  "author": "Erki Aas",
  "bin": {
    "key-manager": "./bin/run"
  },
  "homepage": "https://github.com/passmower/oidc-key-manager",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "passmower/oidc-key-manager",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-help": "^6.2.37",
    "@oclif/plugin-plugins": "^2.4.7",
    "@types/jsrsasign": "^10.5.15",
    "jsrsasign": "^11.1.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.16",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "@types/ws": "^8.18.1",
    "chai": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-oclif": "^6.0.137",
    "mocha": "^12.0.2",
    "oclif": "^4.24.0",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "oclif": {
    "bin": "key-manager",
    "dirname": "key-manager",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint .",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": "https://github.com/passmower/oidc-key-manager/issues",
  "types": "dist/index.d.ts"
}
